 "desc": {
  "tiro_certeiro": {
   "html": "<b>Tiro Certeiro</b><div class=\"tipo\">8 de Foco · 1 flecha · Alvo: Inimigo único</div>\n    <div class=\"bonus\"><span class=\"rx rx-dano\">170% de dano</span>, <span class=\"rx rx-crit\">+30% chance de crítico</span>.</div><div class=\"melhor\">Dano: 48–65 (crítico 90)</div><div class=\"rodape\">Detalhes no Grimório (P).</div>",
   "lado": "esquerda",
   "estilo": "width: 348px; max-height: 144px; left: 30px; top: 0px;"
  },
  "marcar_presa": {
   "html": "<b>Marcar Presa</b><div class=\"tipo\">6 de Foco · Alvo: Inimigo único</div>\n    <div class=\"bonus\">O alvo recebe <span class=\"rx rx-dano\">+25% de dano</span> de todos (você e aliados) por 3 turnos.</div>",
   "lado": "esquerda",
   "estilo": "width: 348px; max-height: 144px; left: 30px; top: 0px;"
  },
  "chuva_flechas": {
   "html": "<b>Chuva de Flechas</b><div class=\"tipo\">20 de Foco · 3 flechas · Alvo: Todos os inimigos</div>\n    <div class=\"bonus\">Atinge todos os inimigos. Gasta uma flecha por inimigo.</div><div class=\"melhor\">Em cada inimigo: 28–38 (crítico 53)</div><div class=\"rodape\">Detalhes no Grimório (P).</div><div class=\"pior\">Foco insuficiente</div>",
   "lado": "esquerda",
   "estilo": "width: 348px; max-height: 144px; left: 30px; top: 0px;"
  },
  "passo_agil": {
   "html": "<b>Passo Ágil</b><div class=\"tipo\">6 de Foco · Alvo: Você</div>\n    <div class=\"bonus\"><span class=\"rx rx-esquiva\">+30% de esquiva</span> por 2 turnos (a <span class=\"rx rx-esquiva\">esquiva</span> total não passa de <span class=\"rx rx-num\">60%</span>).</div>",
   "lado": "esquerda",
   "estilo": "width: 348px; max-height: 144px; left: 30px; top: 0px;"
  },
  "desaparecer": {
   "html": "<b>Desaparecer</b><div class=\"tipo\">10 de Foco · Alvo: Você</div>\n    <div class=\"bonus\">Próximo ataque é <span class=\"rx rx-crit\">crítico</span> devastador; +<span class=\"rx rx-esquiva\">esquiva</span>.</div>",
   "lado": "direita",
   "estilo": "width: 348px; max-height: 144px; left: 408px; top: -66px;"
  },
  "flecha_envenenada": {
   "html": "<b>Flecha Envenenada</b><div class=\"tipo\">10 de Foco · 1 flecha · Alvo: Inimigo único</div>\n    <div class=\"bonus\">Dano e <span class=\"rx rx-veneno\">veneno</span> forte por 4 turnos (não afeta mortos-vivos nem construtos).</div><div class=\"melhor\">Dano: 28–38 (crítico 53)</div><div class=\"rodape\">Detalhes no Grimório (P).</div>",
   "lado": "direita",
   "estilo": "width: 348px; max-height: 144px; left: 408px; top: -66px;"
  },
  "execucao": {
   "html": "<b>Execução</b><div class=\"tipo\">16 de Foco · 1 flecha · Alvo: Inimigo único</div>\n    <div class=\"bonus\"><span class=\"rx rx-dano\">320% de dano</span> se o alvo estiver abaixo de <span class=\"rx rx-num\">35%</span> de vida.</div><div class=\"melhor\">Alvo com mais de 35% de vida: 33–45 (crítico 63)</div><div class=\"rodape\">Detalhes no Grimório (P).</div><div class=\"pior\">Foco insuficiente</div>",
   "lado": "direita",
   "estilo": "width: 348px; max-height: 144px; left: 408px; top: -66px;"
  }
 },
